    }
  },
  "_generation_health_snapshot": {
    "module": "health",
    "bindings": {
      "VercelStorage": "storage",
      "_load_json_redis": "load_json",
      "_read_generation_report": "read_report"
    }
  },
  "scale_and_score_report": {
    "module": "scaling",
    "bindings": {
      "score_cross_section": "score"
    }
  },
  "_get_cached_oi": {
    "module": "enrichment",
    "bindings": {
      "_OI_CACHE": "cache_state",
      "fetch_oi_metrics": "fetch",
      "unavailable_oi_metrics": "unavailable"
    }
  },
  "_enrich_with_signals": {
    "module": "enrichment",
    "bindings": {
      "requests": "http",
      "_get_cached_oi": "get_oi",
      "enrich_token": "classify",
      "compute_market_context": "market_context",
      "get_oi_provider_order": "provider_order",
      "unavailable_oi_metrics": "unavailable"
    }
  },
  "_perform_optimized_pipeline": {
    "module": "pipeline",
    "bindings": {
      "bootstrap_cache": "bootstrap",
      "_try_serve_from_cache": "try_cache",
      "_default_start_date": "start_date",
      "run_lightweight_analysis": "analyse",
      "_save_to_cache_layers": "save",
      "load_precomputed_report": "fallback",
      "scale_and_score_report": "scale",
      "_enrich_with_signals": "enrich"
    }
  },
  "_fast_hydrate": {
    "module": "fast_hydrate",
    "bindings": {
      "_resolve_target_report": "resolve_report",
      "requests": "http",
      "VercelStorage": "storage"
    }
  },
  "_get_cached_or_compute": {
    "module": "dispatch",
    "bindings": {
      "_fast_hydrate": "hydrate",
      "_resolve_target_report": "resolve_report",
      "normalize_instruments_lw": "normalize",
      "VercelStorage": "storage",
      "_serve_stale_or_fallback": "stale_fallback",
      "_try_serve_from_cache": "try_cache",
      "_perform_optimized_pipeline": "build"
    }
  }
