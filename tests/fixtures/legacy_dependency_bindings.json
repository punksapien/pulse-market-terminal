{
  "bootstrap_cache": {
    "module": "cache",
    "bindings": {
      "ROOT": "root"
    }
  },
  "load_precomputed_report": {
    "module": "cache",
    "bindings": {
      "ROOT": "root"
    }
  },
  "_tmp_cache_path": {
    "module": "cache",
    "bindings": {}
  },
  "_try_serve_from_cache": {
    "module": "cache",
    "bindings": {
      "_CACHE": "cache_state",
      "VercelStorage": "storage",
      "CACHE_TTL": "cache_ttl",
      "_tmp_cache_path": "cache_path"
    }
  },
  "_serve_stale_or_fallback": {
    "module": "cache",
    "bindings": {
      "_CACHE": "cache_state",
      "VercelStorage": "storage",
