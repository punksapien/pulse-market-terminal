    "module": "generation",
    "bindings": {}
  },
  "_report_age_seconds": {
    "module": "generation",
    "bindings": {}
  },
  "_generation_manifest_key": {
    "module": "generation",
    "bindings": {}
  },
  "_generation_report_key": {
    "module": "generation",
    "bindings": {}
  },
  "_manifest_combinations": {
    "module": "generation",
    "bindings": {}
  },
  "_validate_manifest": {
    "module": "generation",
    "bindings": {}
  },
  "_validate_generated_report": {
    "module": "generation",
    "bindings": {}
  },
  "_serving_metadata": {
    "module": "generation",
    "bindings": {}
  },
  "_validate_generation_set": {
    "module": "generation",
    "bindings": {}
  },
  "_load_json_redis": {
    "module": "generation",
    "bindings": {
      "VercelStorage": "storage"
    }
  },
  "_generation_candidate_ids": {
    "module": "generation",
    "bindings": {
      "VercelStorage": "storage"
    }
  },
