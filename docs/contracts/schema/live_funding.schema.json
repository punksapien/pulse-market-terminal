{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pulse:schema:v1:live_funding",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "pulse.live_funding.v1"
    },
    "mapping_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "generated_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "expires_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8192,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 0,
            "maximum": 8191
          },
          "status": {
            "enum": [
              "available",
              "unavailable",
              "settlement_pending",
              "unsupported"
            ]
          },
          "reason": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              {
                "type": "null"
              }
            ]
          },
          "source_ms": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "expires_ms": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "input_refs": {
            "type": "array",
            "maxItems": 8,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_.:-]+$"
            }
          },
          "h": {
            "anyOf": [
              {
                "enum": [
                  1,
                  4,
                  8
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "nft": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "fr": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?(?:[0-9]|[1-3][0-9]|40))?$"
              },
              {
                "type": "null"
              }
            ]
          },
          "efr": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?(?:[0-9]|[1-3][0-9]|40))?$"
              },
              {
                "type": "null"
              }
            ]
          },
          "level": {
            "enum": [
              1,
              2,
              3,
              4
            ]
          },
          "classification_version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_.:-]+$"
          }
        },
        "required": [
          "id",
          "status",
          "reason",
          "source_ms",
          "expires_ms",
          "input_refs",
          "h",
          "nft",
          "fr",
          "efr"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "available"
                }
              }
            },
            "then": {
              "properties": {
                "reason": {
                  "type": "null"
                },
                "source_ms": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "expires_ms": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "input_refs": {
                  "minItems": 1
                },
                "h": {
                  "enum": [
                    1,
                    4,
                    8
                  ]
                },
                "nft": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "fr": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?(?:[0-9]|[1-3][0-9]|40))?$"
                },
                "efr": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?(?:[0-9]|[1-3][0-9]|40))?$"
                }
              }
            },
            "else": {
              "properties": {
                "reason": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "efr": {
                  "type": "null"
                }
              }
            }
          }
        ]
      }
    },
    "inputs": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 65536,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9_.:-]+$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_.:-]+$"
          },
          "source_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "verified_at_ms": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "expires_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "definition_version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_.:-]+$"
          }
        },
        "required": [
          "version",
          "source_ms",
          "verified_at_ms",
          "expires_ms",
          "definition_version"
        ]
      }
    }
  },
  "required": [
    "schema",
    "mapping_version",
    "sequence",
    "generated_ms",
    "expires_ms",
    "rows",
    "inputs"
  ]
}
