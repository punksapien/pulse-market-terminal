{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pulse:schema:v1:manifest",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "pulse.manifest.v1"
    },
    "mapping_version": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "generation": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "horizon": {
      "enum": [
        "1H",
        "4H",
        "24H"
      ]
    },
    "generated_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "expires_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "parts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "core": {
          "$ref": "urn:pulse:schema:v1:artifact"
        },
        "volatility": {
          "$ref": "urn:pulse:schema:v1:artifact"
        },
        "ls": {
          "$ref": "urn:pulse:schema:v1:artifact"
        },
        "funding": {
          "$ref": "urn:pulse:schema:v1:artifact"
        },
        "funding_change": {
          "$ref": "urn:pulse:schema:v1:artifact"
        },
        "oi": {
          "$ref": "urn:pulse:schema:v1:artifact"
        },
        "references": {
          "$ref": "urn:pulse:schema:v1:artifact"
        }
      },
      "required": [
        "core",
        "volatility",
        "ls",
        "funding",
        "funding_change",
        "oi",
        "references"
      ]
    }
  },
  "required": [
    "schema",
    "mapping_version",
    "generation",
    "horizon",
    "generated_ms",
    "expires_ms",
    "parts"
  ]
}
