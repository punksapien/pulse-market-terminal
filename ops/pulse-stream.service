[Unit]
Description=Pulse staging price stream publisher
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=pulse-stream
Group=pulse-stream
WorkingDirectory=/opt/pulse-stream
EnvironmentFile=/etc/pulse-stream/staging.env
ExecStart=/usr/bin/node /opt/pulse-stream/pulse/stream/daemon.cjs
Restart=on-failure
RestartPreventExitStatus=78
RestartSec=30
TimeoutStopSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
MemoryMax=192M
TasksMax=128
UMask=0077

[Install]
WantedBy=multi-user.target
