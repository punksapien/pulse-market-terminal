[Unit]
Description=Pulse bounded report-only host health sample

[Service]
Type=oneshot
DynamicUser=yes
ExecStart=/usr/bin/python3 -I -B /opt/pulse-stream/ops/pulse-host-health.py
TimeoutStartSec=5
MemoryMax=24M
TasksMax=8
Nice=19
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
InaccessiblePaths=-/etc/pulse-stream -/var/lib/pulse-handover -/etc/ssh
LogNamespace=pulse
UMask=0077
