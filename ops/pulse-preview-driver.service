[Unit]
Description=Pulse fixed Preview worker and publisher cadence
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=pulse-driver
Group=pulse-driver
WorkingDirectory=/opt/pulse-stream
EnvironmentFile=/etc/pulse-stream/driver.env
ExecStart=/usr/bin/node /opt/pulse-stream/pulse/stream/preview_driver.cjs
Restart=on-failure
RestartPreventExitStatus=78
RestartSec=60
TimeoutStopSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
MemoryMax=96M
TasksMax=32
UMask=0077

[Install]
WantedBy=multi-user.target
