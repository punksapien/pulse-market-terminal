                  "4H": {
                    "allOf": [
                      {
                        "allOf": [
                          {
                            "$ref": "urn:pulse:schema:v1:common#/$defs/numericField"
                          },
                          {
                            "properties": {
                              "unit": {
                                "const": "fraction"
                              },
                              "definition_version": {
                                "const": "volatility.v1"
                              }
                            }
                          }
                        ]
                      }
                    ]
                  },
                  "24H": {
                    "allOf": [
                      {
                        "allOf": [
                          {
                            "$ref": "urn:pulse:schema:v1:common#/$defs/numericField"
